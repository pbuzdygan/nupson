NUPSON_HTTP_HOST=0.0.0.0
# With host networking NUPSON listens directly on this host port.
NUPSON_HTTP_PORT=8480
NUPSON_DATA_DIR=/data
NUPSON_NUT_HOST=127.0.0.1
NUPSON_NUT_PORT=3493
NUPSON_MANAGE_NUT=true
NUPSON_DEMO=false
# Set these to the numeric owner of the bind-mounted data directory.
# Usually these are the values printed by: id -u && id -g
NUPSON_UID=1000
NUPSON_GID=1000
# Optional: use a published image instead of the local nupson:local tag.
# NUPSON_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
# Required only for the direct USB profile. Replace 995 with the GID printed by:
# getent group nupson-usb
NUPSON_USB_GID=995
